{
  "name": "gge-storm-dungeons",
  "version": "0.1.0",
  "private": true,
  "description": "HIS1 storm islands and fortress tracker: GitHub Pages + Supabase + Render",
  "scripts": {
    "db:apply": "node scripts/apply-migrations.mjs",
    "seed": "npm --prefix apps/collector run seed",
    "collector": "npm --prefix apps/collector run start",
    "collector:storm": "npm --prefix apps/collector run storm",
    "collector:dungeons": "npm --prefix apps/collector run dungeons",
    "web": "npm --prefix apps/web start",
    "empire-api": "npm --prefix apps/empire-api start",
    "test:smoke": "node scripts/smoke-no-toast.mjs",
    "init": "npm --prefix apps/collector run init",
    "test:permissions": "node scripts/test-permissions.mjs",
    "test:init-plan": "npm --prefix apps/collector run build && node scripts/test-dungeon-plan.mjs && node scripts/test-dungeon-parse.mjs"
  }
}
