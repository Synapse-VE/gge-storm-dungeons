# --- Supabase -------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Public key used by the static frontend (safe to ship). RLS is read-only.
SUPABASE_ANON_KEY=your-anon-key
# Server-only key used by the collector (never ship it to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Management API token, only needed to apply migrations from a script.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- Game bridge (empire-api) --------------------------------------------
# Local default: the empire-api copy running on :3100 with a path secret.
GGE_API_URL=http://127.0.0.1:3100/change-me
GGE_API_SECRET=change-me
GGE_ZONE=EmpireEx_25
GGE_USERNAME=your-game-account
GGE_PASSWORD=your-game-password
GGE_LANG=fr
GGE_HTTP_TIMEOUT_MS=30000

# --- Collector ------------------------------------------------------------
COLLECTOR_STORM_CRON="*/10 * * * *"
COLLECTOR_DUNGEONS_CRON="*/15 * * * *"
COLLECTOR_RUN_ON_START=1

# --- Ports ----------------------------------------------------------------
PORT=3000
